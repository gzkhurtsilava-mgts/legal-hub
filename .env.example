# ===========================
# Legal Hub — конфигурация
# Скопируйте в .env и заполните
# ===========================

# Приложение
APP_ENV=development
SECRET_KEY=замените-на-случайную-строку-минимум-32-символа

# База данных
POSTGRES_DB=legalhub
POSTGRES_USER=legalhub
POSTGRES_PASSWORD=legalhub_dev

# Redis
REDIS_URL=redis://redis:6379

# CORS — адреса откуда разрешены запросы к API
CORS_ORIGINS=["http://localhost:3000"]

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000
# Внутренний URL бэкенда для server-side запросов NextAuth внутри Docker
# Локально без Docker — не указывать (упадёт на NEXT_PUBLIC_API_URL)
BACKEND_INTERNAL_URL=http://backend:8000

# NextAuth — обязательны, иначе авторизация не поднимется
# NEXTAUTH_SECRET сгенерировать: openssl rand -base64 32
NEXTAUTH_SECRET=замените-на-случайную-строку-минимум-32-символа
NEXTAUTH_URL=http://localhost:3000

# File storage (Docker volume, путь внутри контейнера)
MEDIA_ROOT=/media

# Office → PDF конвертер (JodConverter REST) — конструктор доверенностей
JODCONVERTER_URL=http://jodconverter:8080

# Почта (заполнить позже)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=legal-portal@mgts.ru

# SSO (заполнить когда дадут провайдер)
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_DISCOVERY_URL=
