# ==========================================
# Legal Hub — frontend (Next.js)
# Скопируйте в .env.local и заполните
# ==========================================
# Нужен только при запуске фронтенда ВНЕ Docker (npm run dev).
# В Docker переменные приходят из корневого .env через docker-compose.

# Адрес API бэкенда (виден браузеру)
NEXT_PUBLIC_API_URL=http://localhost:8000

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# Сгенерировать: openssl rand -base64 32
NEXTAUTH_SECRET=замените-на-случайную-строку-минимум-32-символа
