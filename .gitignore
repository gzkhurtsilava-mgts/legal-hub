# Секреты — никогда в git
.env
*.env.local

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
/dist/
backend/dist/
!frontend/vendor/**/dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
.next/
out/
build/
# vendor/@mts-ds — это НЕ артефакты сборки, а содержимое корп-пакетов
# (в их package.json поле "files" указывает на build/**). Без них клон неполный.
!frontend/vendor/**/build/
frontend/.mts-ds-backup/
*.tsbuildinfo

# Docker
.docker/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
frontend/next-env.d.ts
frontend/.npmrc
